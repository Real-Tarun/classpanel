# ClassPanel Cloudflare Pages Redirect Rules
# Permanent 301 redirects for SEO canonicalization

# Homepage duplicate path resolution
/index.html / 301
/index.php / 301

# Subdirectory clean URL normalization
/tools /tools/ 301
/tools/index.html /tools/ 301
/tools/*/index.html /tools/:splat/ 301
/blog/*/index.html /blog/:splat/ 301
/about/index.html /about/ 301
/privacy/index.html /privacy/ 301
/contact/index.html /contact/ 301

# i18n language paths — clean URL normalization
/es /es/ 301
/es/index.html /es/ 301
/es/tools /es/tools/ 301
/es/tools/*/index.html /es/tools/:splat/ 301
/fr /fr/ 301
/fr/index.html /fr/ 301
/fr/tools /fr/tools/ 301
/fr/tools/*/index.html /fr/tools/:splat/ 301
/de /de/ 301
/de/index.html /de/ 301
/de/tools /de/tools/ 301
/de/tools/*/index.html /de/tools/:splat/ 301

