{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classpanel",
  "compatibility_date": "2026-09-18",
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classpanel-db",
      "database_id": "classpanel-db-id"
    }
  ],
  "observability": {
    "enabled": true
  }
}
