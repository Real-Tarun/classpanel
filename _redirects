# ClassPanel Cloudflare Pages Redirect Rules
# Permanent 301 redirects for SEO canonicalization

# Homepage duplicate path resolution
/index.html / 301
/index.php / 301

# Subdirectory clean URL normalization
/tools /tools/ 301
/tools/index.html /tools/ 301
/tools/*/index.html /tools/:splat/ 301
/blog/*/index.html /blog/:splat/ 301
/about/index.html /about/ 301
/privacy/index.html /privacy/ 301
/contact/index.html /contact/ 301
/terms/index.html /terms/ 301

# Legacy language path fallback (prevent 404s)
/es / 301
/es/* / 301
/fr / 301
/fr/* / 301
/de / 301
/de/* / 301

# Tool clean paths (trailing slash enforcement)
/tools/metronome /tools/metronome/ 301
/tools/chess-timer /tools/chess-timer/ 301
/tools/talking-clock /tools/talking-clock/ 301
/tools/bomb-countdown /tools/bomb-countdown/ 301
/tools/custom-timer /tools/custom-timer/ 301
/tools/split-timer /tools/split-timer/ 301
